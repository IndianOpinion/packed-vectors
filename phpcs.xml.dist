<?xml version="1.0"?>
<ruleset name="packed-vectors">
    <description>PSR-12 for packed-vectors.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>benchmarks</file>
    <file>bootstrap.php</file>
    <exclude-pattern>tests/fixtures/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <!-- Stream wrapper method names are fixed by PHP. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/Support/*Stream.php</exclude-pattern>
    </rule>
    <!-- Runnable scripts may define a helper function next to their logic. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>benchmarks/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="140"/>
        </properties>
    </rule>
    <rule ref="Generic.PHP.NoSilencedErrors"/>
    <rule ref="Squiz.PHP.Eval"/>
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="exec" value="null"/>
                <element key="shell_exec" value="null"/>
                <element key="system" value="null"/>
                <element key="passthru" value="null"/>
                <element key="popen" value="null"/>
                <element key="unserialize" value="null"/>
            </property>
        </properties>
    </rule>
</ruleset>
